{
  "routes": [
    {
      "route": "/about.html",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/.auth/login/aad",
      "statusCode": 302
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad?post_login_redirect_uri=/about.html",
      "statusCode": 302
    }
  }
}
